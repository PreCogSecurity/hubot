# Environment variables for Hubot

# Required adapter configuration
HUBOT_ADAPTER=shell

# Robot identity
HUBOT_NAME=Hubot
HUBOT_ALIAS=

# Logging
HUBOT_LOG_LEVEL=info

# Express server (when HTTP server is enabled)
EXPRESS_USER=hubot
EXPRESS_PASSWORD=hubot
EXPRESS_PORT=8080
PORT=8080
BIND_ADDRESS=0.0.0.0

# Keep-alive ping (Heroku)
HEROKU_URL=http://your-app-name.herokuapp.com